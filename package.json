{
  "name": "bright-supply",
  "version": "3.0.0",
  "description": "Turn any screen into an adjustable fullscreen light in white or 13 vivid colors, with 18 localized editions.",
  "main": "index.html",
  "scripts": {
    "start": "python -m http.server 8000",
    "serve": "python3 -m http.server 8000",
    "dev": "python -m http.server 8000",
    "generate": "node scripts/generate-pages.mjs",
    "build": "npm run generate && npm run validate",
    "deploy": "echo 'Deploy to your hosting provider'",
    "test": "npm run build",
    "check": "npm run build",
    "lint": "npm run validate",
    "validate": "node scripts/validate.mjs",
    "format": "echo 'No formatter configured'"
  },
  "keywords": [
    "lightbox",
    "video-calls",
    "monitor",
    "lighting",
    "webcam",
    "video-conferencing",
    "html5",
    "css3",
    "javascript",
    "vanilla-js",
    "web-app",
    "utility",
    "productivity",
    "pwa",
    "progressive-web-app"
  ],
  "author": {
    "name": "banastas",
    "email": "info@bright.supply",
    "url": "https://banast.as"
  },
  "license": "MIT",
  "homepage": "https://bright.supply",
  "repository": {
    "type": "git",
    "url": "https://github.com/banastas/bright.supply.git"
  },
  "bugs": {
    "url": "https://github.com/banastas/bright.supply/issues"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "files": [
    "index.html",
    "styles.css",
    "app.js",
    "sw.js",
    "manifest.json",
    "sitemap.xml",
    "scripts/validate.mjs",
    "scripts/generate-pages.mjs",
    "scripts/site-data.mjs",
    "assets/images/bright.supply.png",
    "assets/images/readme.png",
    "robots.txt",
    "docs/API.md",
    "docs/ROUTING_AND_SEO.md",
    "LICENSE",
    "README.md"
  ],
  "devDependencies": {},
  "dependencies": {},
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
